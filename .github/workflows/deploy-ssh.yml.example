# Ejemplo opcional: Despliegue automático directo vía SSH
# Si tienes un VPS (DigitalOcean, AWS EC2, Linode, etc.) con IP pública:
# 1. Agrega los secrets en GitHub -> Settings -> Secrets and variables -> Actions:
#    - SERVER_HOST (ej. 192.0.2.1)
#    - SERVER_USER (ej. ubuntu)
#    - SSH_PRIVATE_KEY (tu llave privada SSH)
# 2. Renombra este archivo quitando el sufijo .example: `deploy-ssh.yml`

name: Deploy via SSH (Alternativa Directa)

on:
  workflow_dispatch: # Permite ejecución manual
  # push:
  #   branches: [ main ]

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Ejecutar despliegue en servidor remoto vía SSH
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.SERVER_HOST }}
          username: ${{ secrets.SERVER_USER }}
          key: ${{ secrets.SSH_PRIVATE_KEY }}
          script: |
            cd ~/finanzas-personales
            git pull origin main
            docker compose up -d --build

